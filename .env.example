# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The live address of the site, e.g. https://www.example.com (used for the sitemap and links for search engines).
NEXT_PUBLIC_SITE_URL=

# From Supabase: Project Settings > API (or "Connect"). Both are safe to use in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
